<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="540.0" prefWidth="600.0" style="-fx-background-color: #F5EFE6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.recipeplanner.Controller.SearchController">
    <top>
        <StackPane fx:id="headerStack" prefHeight="110.0" style="-fx-background-color: #c8a27d; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 6, 0, 0, 2);">
            <children>
                <VBox alignment="CENTER" spacing="4.0" mouseTransparent="true">
                    <children>
                        <Label text="Find a Recipe" textFill="#5c3a21">
                            <font>
                                <Font name="Georgia Bold" size="22.0" />
                            </font>
                        </Label>
                        <Label text="Search your recipe collection" textFill="#76543B">
                            <font>
                                <Font name="Segoe UI" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <HBox alignment="CENTER_LEFT" StackPane.alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16.0" />
                    </padding>
                    <children>
                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: #A97C50; -fx-background-radius: 16; -fx-cursor: hand; -fx-padding: 5 16 5 16;" text="← Back" textFill="WHITE">
                            <font>
                                <Font name="Segoe UI Semibold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </StackPane>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #F5EFE6; -fx-background-color: transparent;" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="24.0" left="30.0" right="30.0" top="24.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <TextField fx:id="searchField" prefWidth="320.0" prefHeight="40.0" promptText="Search recipes..." style="-fx-background-radius: 20; -fx-background-color: #FFFDF9; -fx-border-color: #E0D2BE; -fx-border-radius: 20; -fx-padding: 0 16 0 16;">
                                    <font>
                                        <Font name="Segoe UI" size="13.0" />
                                    </font>
                                </TextField>
                                <Button fx:id="searchButton" mnemonicParsing="false" onAction="#handleSearch" prefHeight="40.0" text="Search" textFill="WHITE" style="-fx-background-color: #A97C50; -fx-background-radius: 20; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 22 0 22;" />
                            </children>
                        </HBox>
                        <Label text="Enter a recipe name..." textFill="#9c8b7a">
                            <font>
                                <Font name="Segoe UI" size="11.0" />
                            </font>
                        </Label>
                        <Label fx:id="resultLabel" text="" textFill="#6b5b4d">
                            <font>
                                <Font name="Segoe UI" size="12.0" />
                            </font>
                        </Label>
                        <Label text="SEARCH RESULTS" textFill="#8a5a35">
                            <font>
                                <Font name="Segoe UI Semibold" size="12.0" />
                            </font>
                        </Label>
                        <VBox minHeight="260.0" style="-fx-background-color: #FFFDF9; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <VBox fx:id="resultsContainer" spacing="8.0" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>