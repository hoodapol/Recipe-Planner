<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.recipeplanner.Controller.SearchController">
    <Label text="Recipe Planner - Search"/>
    <TextField fx:id="searchField" promptText="Search recipes..."/>
    <Button fx:id="searchButton" text="Search" onAction="#handleSearch"/>
    <Label fx:id="resultLabel" text=""/>
</VBox>