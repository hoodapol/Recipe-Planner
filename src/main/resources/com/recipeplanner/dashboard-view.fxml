<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="720.0" style="-fx-background-color: #F5EFE6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.recipeplanner.Controller.DashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: #c8a27d; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 6, 0, 0, 2);">
            <padding>
                <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
            </padding>
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label text="Recipe Planner" textFill="#5c3a21">
                            <font>
                                <Font name="Georgia Bold" size="22.0" />
                            </font>
                        </Label>
                        <Label text="Your personal recipe hub" textFill="#76543B">
                            <font>
                                <Font name="Segoe UI" size="11.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" prefWidth="260.0" prefHeight="36.0" promptText="Search recipes..." style="-fx-background-radius: 18; -fx-background-color: #FFFDF9; -fx-padding: 0 16 0 16;">
                    <font>
                        <Font name="Segoe UI" size="13.0" />
                    </font>
                </TextField>
                <Button fx:id="searchButton" mnemonicParsing="false" prefHeight="36.0" text="Search" textFill="WHITE" style="-fx-background-color: #A97C50; -fx-background-radius: 18; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 20 0 20;" />
            </children>
        </HBox>
    </top>
    <left>
        <BorderPane prefWidth="180.0" style="-fx-background-color: #FFFBF5;">
            <top>
                <VBox spacing="6.0">
                    <padding>
                        <Insets bottom="10.0" left="18.0" right="18.0" top="24.0" />
                    </padding>
                    <children>
                        <Label text="MENU" textFill="#B08968">
                            <font>
                                <Font name="Segoe UI Semibold" size="11.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </top>
            <center>
                <VBox spacing="6.0" BorderPane.alignment="TOP_CENTER">
                    <padding>
                        <Insets left="12.0" right="12.0" top="4.0" />
                    </padding>
                    <children>
                        <Button fx:id="homeNavButton" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showHome" prefHeight="40.0" style="-fx-background-color: #EADFCF; -fx-background-radius: 10;" text="🏠  Home" textFill="#5c3a21">
                            <font>
                                <Font name="Segoe UI Semibold" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="favoritesNavButton" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showFavorites" prefHeight="40.0" style="-fx-background-color: transparent; -fx-background-radius: 10;" text="❤  Favorites" textFill="#6b5b4d">
                            <font>
                                <Font name="Segoe UI" size="13.0" />
                            </font>
                        </Button>
                        <Button fx:id="categoriesNavButton" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showCategories" prefHeight="40.0" style="-fx-background-color: transparent; -fx-background-radius: 10;" text="📂  Categories" textFill="#6b5b4d">
                            <font>
                                <Font name="Segoe UI" size="13.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #F5EFE6; -fx-background-color: transparent;" BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="contentArea" spacing="14.0">
                    <padding>
                        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>