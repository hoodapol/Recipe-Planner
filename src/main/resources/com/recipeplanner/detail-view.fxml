<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="560.0" prefWidth="600.0" style="-fx-background-color: #F5EFE6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.recipeplanner.Controller.DetailController">
    <top>
        <StackPane fx:id="headerStack" prefHeight="90.0" prefWidth="606.0" BorderPane.alignment="CENTER">
            <children>
                <Rectangle fx:id="headerRect" fill="#c8a27d" height="90.0" strokeType="INSIDE" strokeWidth="0.0">
                    <effect>
                        <DropShadow />
                    </effect>
                </Rectangle>
                <HBox alignment="CENTER_LEFT" maxWidth="606.0" spacing="10.0" StackPane.alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="12.0" />
                    </padding>
                    <children>
                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: rgba(255,255,255,0.35); -fx-background-radius: 18; -fx-border-color: transparent; -fx-padding: 6 18 6 18;" text="← Back" textFill="#5c3a21">
                            <font>
                                <Font name="Segoe UI Semibold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </StackPane>
    </top>
    <center>
        <VBox spacing="14.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="24.0" left="30.0" right="30.0" top="24.0" />
            </padding>
            <children>
                <Label fx:id="titleLabel" text="Recipe Title" textFill="#5c3a21">
                    <font>
                        <Font name="Georgia Bold" size="24.0" />
                    </font>
                </Label>
                <Label fx:id="categoryLabel" text="Category: -" textFill="#A97C50">
                    <font>
                        <Font name="Segoe UI Semibold" size="13.0" />
                    </font>
                </Label>
                <Label fx:id="descriptionLabel" text="Description goes here" textFill="#6b5b4d" wrapText="true">
                    <font>
                        <Font name="Segoe UI" size="13.0" />
                    </font>
                </Label>
                <Label fx:id="nutritionLabel" text="" textFill="#6b5b4d">
                    <font>
                        <Font name="Segoe UI Italic" size="12.0" />
                    </font>
                </Label>
                <Button fx:id="favoriteButton" mnemonicParsing="false" onAction="#handleToggleFavorite" style="-fx-background-color: #A97C50;" text="Save to Favorites" textFill="WHITE">
                    <font>
                        <Font name="Segoe UI Semibold" size="12.0" />
                    </font>
                </Button>
                <Label text="Ingredients" textFill="#5c3a21">
                    <font>
                        <Font name="Segoe UI Semibold" size="15.0" />
                    </font>
                </Label>
                <ListView fx:id="ingredientsListView" prefHeight="110.0" />
                <Label text="Steps" textFill="#5c3a21">
                    <font>
                        <Font name="Segoe UI Semibold" size="15.0" />
                    </font>
                </Label>
                <ListView fx:id="stepsListView" prefHeight="140.0" />
            </children>
        </VBox>
    </center>
</BorderPane>