<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="580.0" prefWidth="620.0" style="-fx-background-color: #F5EFE6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.recipeplanner.Controller.DetailController">
    <top>
        <StackPane fx:id="headerStack" prefHeight="56.0" style="-fx-background-color: #c8a27d; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 6, 0, 0, 2);">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0" StackPane.alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16.0" />
                    </padding>
                    <children>
                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: #A97C50; -fx-background-radius: 16; -fx-cursor: hand; -fx-padding: 5 16 5 16;" text="← Back" textFill="WHITE">
                            <font>
                                <Font name="Segoe UI Semibold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </StackPane>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #F5EFE6; -fx-background-color: transparent;" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="28.0" left="30.0" right="30.0" top="24.0" />
                    </padding>
                    <children>
                        <Label text="RECIPE" textFill="#B08968">
                            <font>
                                <Font name="Segoe UI Semibold" size="11.0" />
                            </font>
                        </Label>
                        <Label fx:id="titleLabel" text="Recipe Title" textFill="#5c3a21">
                            <font>
                                <Font name="Georgia Bold" size="26.0" />
                            </font>
                        </Label>
                        <Label fx:id="categoryLabel" text="-" textFill="#5c3a21" style="-fx-background-color: #EADFCF; -fx-background-radius: 12; -fx-padding: 4 14 4 14;">
                            <font>
                                <Font name="Segoe UI Semibold" size="11.0" />
                            </font>
                        </Label>
                        <Label fx:id="descriptionLabel" text="Description goes here" textFill="#6b5b4d" wrapText="true">
                            <font>
                                <Font name="Segoe UI" size="13.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="4.0" bottom="6.0" />
                            </VBox.margin>
                        </Label>
                        <HBox spacing="10.0" style="-fx-background-color: #FFFDF9; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                            <children>
                                <Rectangle width="4.0" height="50.0" arcWidth="4.0" arcHeight="4.0" fill="#A97C50" />
                                <VBox spacing="4.0">
                                    <padding>
                                        <Insets bottom="12.0" left="4.0" right="16.0" top="12.0" />
                                    </padding>
                                    <children>
                                        <Label text="Nutrition" textFill="#B08968">
                                            <font>
                                                <Font name="Segoe UI Semibold" size="11.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="nutritionLabel" text="" textFill="#5c3a21" wrapText="true">
                                            <font>
                                                <Font name="Segoe UI" size="13.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <Button fx:id="favoriteButton" mnemonicParsing="false" onAction="#handleToggleFavorite" prefHeight="42.0" style="-fx-background-color: #A97C50; -fx-background-radius: 21; -fx-cursor: hand;" text="♡  Save to Favorites" textFill="WHITE">
                            <font>
                                <Font name="Segoe UI Semibold" size="13.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="4.0" bottom="6.0" />
                            </VBox.margin>
                        </Button>
                        <Label fx:id="ingredientsHeaderLabel" text="INGREDIENTS" textFill="#B08968">
                            <font>
                                <Font name="Segoe UI Semibold" size="12.0" />
                            </font>
                        </Label>
                        <VBox style="-fx-background-color: #FFFDF9; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                            <children>
                                <ListView fx:id="ingredientsListView" prefHeight="120.0" style="-fx-background-color: transparent; -fx-background-radius: 12;" />
                            </children>
                        </VBox>
                        <Label fx:id="stepsHeaderLabel" text="STEPS" textFill="#B08968">
                            <font>
                                <Font name="Segoe UI Semibold" size="12.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="6.0" />
                            </VBox.margin>
                        </Label>
                        <VBox style="-fx-background-color: #FFFDF9; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                            <children>
                                <ListView fx:id="stepsListView" prefHeight="150.0" style="-fx-background-color: transparent; -fx-background-radius: 12;" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>